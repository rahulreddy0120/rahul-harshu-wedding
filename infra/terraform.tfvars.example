# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored so secrets stay out of version control.

# SHA-256 hex hash of your host admin password.
# Generate with:  printf '%s' 'YOUR_PASSWORD' | shasum -a 256
admin_password_hash = "REPLACE_WITH_SHA256_HASH"

# Random secret for signing admin session tokens.
# Generate with:  openssl rand -hex 32
auth_secret = "REPLACE_WITH_RANDOM_HEX"
